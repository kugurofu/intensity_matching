<?xml version="1.0"?>
<launch>
  <arg name="folder_path" default="~/ros2_ws/src/map/test2"/>
  <arg name="waypoint_start_index" default="0"/>
  <arg name="use_sim_time" default="true"/>
  <!-- local map -->
  <node pkg="intensity_matching" exec="reflection_intensity_localmap_multi_sub">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <!-- map matching -->
  <node pkg="intensity_matching" exec="png_map_matching">
    <param name="folder_path" value="$(var folder_path)"/>
    <param name="waypoint_start_index" value="$(var waypoint_start_index)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
